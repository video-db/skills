{
 "tools": [
  {
   "name": "upload_media",
   "description": "Upload a video, audio file or image from a public URL (direct links and YouTube URLs both work). Returns {status:'processing', output_url, poll_with:'get_job_result'}; poll until done for the media record (id m-..., length, player_url).",
   "inputSchema": {
    "type": "object",
    "properties": {
     "url": {
      "type": "string",
      "description": "Public URL or YouTube link."
     },
     "collection_id": {
      "type": "string",
      "description": "Collection ID, default \"default\"."
     },
     "name": {
      "type": "string"
     },
     "description": {
      "type": "string"
     },
     "media_type": {
      "type": "string",
      "enum": [
       "video",
       "audio",
       "image"
      ]
     }
    },
    "required": [
     "url"
    ]
   }
  },
  {
   "name": "get_job_result",
   "description": "Fetch the result of a background job. Pass the output_url a job-starting tool returned. While running the reply is {status:'processing'} with the same output_url; call again. A done reply with an empty result means call once more.",
   "inputSchema": {
    "type": "object",
    "properties": {
     "output_url": {
      "type": "string"
     }
    },
    "required": [
     "output_url"
    ]
   }
  },
  {
   "name": "generate_transcript",
   "description": "Transcribe a video or audio file. Returns {status:'processing', output_url}; poll get_job_result until done, then read the text with get_transcript. Media that already has a transcript answers done at once.",
   "inputSchema": {
    "type": "object",
    "properties": {
     "media_id": {
      "type": "string",
      "description": "m- (video) or a- (audio) id."
     },
     "collection_id": {
      "type": "string",
      "description": "Collection ID, default \"default\"."
     },
     "force": {
      "type": "boolean"
     },
     "language_code": {
      "type": "string"
     }
    }
   }
  },
  {
   "name": "get_transcript",
   "description": "Get the transcript of a video or audio file, plain or with timestamped segments (per word by default, per sentence, or per time window). Timestamped output is capped at 2000 segments.",
   "inputSchema": {
    "type": "object",
    "properties": {
     "media_id": {
      "type": "string"
     },
     "collection_id": {
      "type": "string",
      "description": "Collection ID, default \"default\"."
     },
     "timestamped": {
      "type": "boolean"
     },
     "segmenter": {
      "type": "string",
      "enum": [
       "word",
       "sentence",
       "time"
      ]
     },
     "segment_length": {
      "type": "integer"
     },
     "start": {
      "type": "number"
     },
     "end": {
      "type": "number"
     }
    }
   }
  },
  {
   "name": "generate_clip",
   "description": "Cut a clip, or a supercut of several segments, from one video without re-encoding. Returns {status:'processing', output_url}; poll get_job_result until it returns stream_url and player_url.",
   "inputSchema": {
    "type": "object",
    "properties": {
     "video_id": {
      "type": "string"
     },
     "collection_id": {
      "type": "string",
      "description": "Collection ID, default \"default\"."
     },
     "timeline": {
      "type": "array",
      "description": "Segments as [start_seconds, end_seconds] pairs.",
      "items": {
       "type": "array",
       "items": {
        "type": "number"
       }
      }
     }
    },
    "required": [
     "video_id",
     "timeline"
    ]
   }
  },
  {
   "name": "compile_clips",
   "description": "Stitch moments from one or more videos into one new stream. Returns a job; poll get_job_result for stream_url and player_url.",
   "inputSchema": {
    "type": "object",
    "properties": {
     "clips": {
      "type": "array",
      "items": {
       "type": "object",
       "properties": {
        "video_id": {
         "type": "string"
        },
        "collection_id": {
         "type": "string"
        },
        "shots": {
         "type": "array",
         "items": {
          "type": "array",
          "items": {
           "type": "number"
          }
         }
        }
       },
       "required": [
        "video_id",
        "shots"
       ]
      }
     }
    },
    "required": [
     "clips"
    ]
   }
  },
  {
   "name": "add_subtitles",
   "description": "Burn subtitles into a video from its transcript. ASS styling; colours are &HAABBGGRR strings. Returns stream_url and player_url at once.",
   "inputSchema": {
    "type": "object",
    "properties": {
     "video_id": {
      "type": "string"
     },
     "collection_id": {
      "type": "string",
      "description": "Collection ID, default \"default\"."
     },
     "font_name": {
      "type": "string"
     },
     "font_size": {
      "type": "integer",
      "minimum": 8,
      "maximum": 72
     },
     "primary_colour": {
      "type": "string"
     },
     "secondary_colour": {
      "type": "string"
     },
     "outline_colour": {
      "type": "string"
     },
     "back_colour": {
      "type": "string"
     },
     "bold": {
      "type": "boolean"
     },
     "italic": {
      "type": "boolean"
     },
     "underline": {
      "type": "boolean"
     },
     "strike_out": {
      "type": "boolean"
     },
     "border_style": {
      "type": "string",
      "enum": [
       "no_border",
       "opaque_box",
       "outline"
      ]
     },
     "outline": {
      "type": "number"
     },
     "shadow": {
      "type": "number"
     },
     "alignment": {
      "type": "string",
      "enum": [
       "bottom_left",
       "bottom_center",
       "bottom_right",
       "middle_left",
       "middle_center",
       "middle_right",
       "top_left",
       "top_center",
       "top_right"
      ]
     },
     "margin_l": {
      "type": "integer"
     },
     "margin_r": {
      "type": "integer"
     },
     "margin_v": {
      "type": "integer"
     }
    },
    "required": [
     "video_id"
    ]
   }
  },
  {
   "name": "create_highlight_clip",
   "description": "Pick the moments of a video that match a prompt (spoken content by default; the speech must be transcribed and indexed). Returns a job; poll get_job_result for the selected shots, then pass them to compile_clips.",
   "inputSchema": {
    "type": "object",
    "properties": {
     "video_id": {
      "type": "string"
     },
     "collection_id": {
      "type": "string",
      "description": "Collection ID, default \"default\"."
     },
     "prompt": {
      "type": "string"
     },
     "content_type": {
      "type": "string",
      "enum": [
       "spoken",
       "visual",
       "multimodal"
      ]
     },
     "model_name": {
      "type": "string",
      "enum": [
       "basic",
       "pro",
       "ultra"
      ]
     }
    },
    "required": [
     "video_id",
     "prompt"
    ]
   }
  },
  {
   "name": "reframe_video",
   "description": "Re-crop a video or a segment of it to vertical, square, landscape or custom dimensions and save it as a new video. Returns {status:'processing', output_url}; poll get_job_result until it returns the new video record.",
   "inputSchema": {
    "type": "object",
    "properties": {
     "video_id": {
      "type": "string"
     },
     "collection_id": {
      "type": "string",
      "description": "Collection ID, default \"default\"."
     },
     "start": {
      "type": "number"
     },
     "end": {
      "type": "number"
     },
     "target": {
      "description": "vertical | square | landscape | {width,height}"
     },
     "mode": {
      "type": "string",
      "enum": [
       "simple",
       "smart"
      ]
     }
    },
    "required": [
     "video_id"
    ]
   }
  },
  {
   "name": "download_stream",
   "description": "Render any VideoDB stream URL into a downloadable MP4 file. Returns a job; poll get_job_result for download_url.",
   "inputSchema": {
    "type": "object",
    "properties": {
     "stream_url": {
      "type": "string"
     },
     "name": {
      "type": "string",
      "description": "File name, e.g. 'clip.mp4'."
     }
    },
    "required": [
     "stream_url",
     "name"
    ]
   }
  },
  {
   "name": "search_videos_by_title",
   "description": "Find videos in a collection whose title matches a natural-language query.",
   "inputSchema": {
    "type": "object",
    "properties": {
     "collection_id": {
      "type": "string",
      "description": "Collection ID, default \"default\"."
     },
     "query": {
      "type": "string"
     }
    },
    "required": [
     "query"
    ]
   }
  },
  {
   "name": "list_videos",
   "description": "List videos in a collection: ids, names, durations, stream and player URLs.",
   "inputSchema": {
    "type": "object",
    "properties": {
     "collection_id": {
      "type": "string",
      "description": "Collection ID, default \"default\"."
     }
    }
   }
  },
  {
   "name": "list_indexes",
   "description": "List the searchable (v2) indexes of a video.",
   "inputSchema": {
    "type": "object",
    "properties": {
     "video_id": {
      "type": "string"
     },
     "collection_id": {
      "type": "string",
      "description": "Collection ID, default \"default\"."
     }
    },
    "required": [
     "video_id"
    ]
   }
  },
  {
   "name": "understand_video",
   "description": "Run analyzers over a video (spoken_words, vlm, ocr, object_detection, brand_detection, activity_recognition, location_detection). Artifacts are not searchable until create_index runs. Poll get_understanding.",
   "inputSchema": {
    "type": "object",
    "properties": {
     "video_id": {
      "type": "string"
     },
     "collection_id": {
      "type": "string",
      "description": "Collection ID, default \"default\"."
     },
     "analyzers": {
      "type": "array",
      "items": {
       "type": "object",
       "properties": {
        "type": {
         "type": "string"
        },
        "name": {
         "type": "string"
        },
        "config": {
         "type": "object"
        }
       },
       "required": [
        "type"
       ]
      }
     },
     "segmentation": {
      "type": "object"
     }
    },
    "required": [
     "video_id",
     "analyzers"
    ]
   }
  },
  {
   "name": "get_understanding",
   "description": "Status of one understanding run and each analyzer in it (pending, running, done, failed).",
   "inputSchema": {
    "type": "object",
    "properties": {
     "video_id": {
      "type": "string"
     },
     "collection_id": {
      "type": "string",
      "description": "Collection ID, default \"default\"."
     },
     "understanding_id": {
      "type": "string"
     }
    },
    "required": [
     "video_id",
     "understanding_id"
    ]
   }
  },
  {
   "name": "create_index",
   "description": "Build a retrieval-ready index from one analyzer's output of an understanding run.",
   "inputSchema": {
    "type": "object",
    "properties": {
     "video_id": {
      "type": "string"
     },
     "collection_id": {
      "type": "string",
      "description": "Collection ID, default \"default\"."
     },
     "understanding_id": {
      "type": "string"
     },
     "analyzer_name": {
      "type": "string"
     },
     "analyzer_id": {
      "type": "string"
     },
     "name": {
      "type": "string"
     },
     "use_for": {
      "type": "array",
      "items": {
       "type": "string"
      }
     }
    },
    "required": [
     "video_id",
     "understanding_id"
    ]
   }
  },
  {
   "name": "search_video",
   "description": "Search within one video for matching moments with timestamps. Reads indexes built by create_index.",
   "inputSchema": {
    "type": "object",
    "properties": {
     "video_id": {
      "type": "string"
     },
     "collection_id": {
      "type": "string",
      "description": "Collection ID, default \"default\"."
     },
     "query": {
      "type": "string"
     },
     "top_k": {
      "type": "integer"
     },
     "mode": {
      "type": "string",
      "enum": [
       "default",
       "deepsearch"
      ]
     },
     "include_clip": {
      "type": "boolean"
     },
     "session_id": {
      "type": "string"
     }
    },
    "required": [
     "video_id",
     "query"
    ]
   }
  },
  {
   "name": "ask_video",
   "description": "Answer a natural-language question from one video's indexed content.",
   "inputSchema": {
    "type": "object",
    "properties": {
     "video_id": {
      "type": "string"
     },
     "collection_id": {
      "type": "string",
      "description": "Collection ID, default \"default\"."
     },
     "question": {
      "type": "string"
     },
     "top_k": {
      "type": "integer"
     },
     "include_sources": {
      "type": "boolean"
     }
    },
    "required": [
     "video_id",
     "question"
    ]
   }
  }
 ]
}